<Project>
  <!-- Las carpetas de compilación terminan en ~ para que Unity las ignore: así el proyecto de Unity puede usar esta
       carpeta tal cual como paquete (Packages/manifest.json → "file:...") sin importar las dll ni el código generado. -->
  <PropertyGroup>
    <BaseOutputPath>bin~\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj~\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
